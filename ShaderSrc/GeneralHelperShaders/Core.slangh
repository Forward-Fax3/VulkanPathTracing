#pragma once


static const uint spotLight = 0;
static const uint pointLight = 1;
static const uint directionalLight = 2;

static const float pi = 3.14159265f;
static const float pi2 = pi * pi;
static const float oneOverPi = 1.0f / pi;
static const float oneOverPi2 = 1.0f / pi2;

void BuildOrthonormalBasis(float3 n, out float3 tangent, out float3 bitangent)
{
    float sign = n.z >= 0.0 ? 1.0 : -1.0;
    float a = -1.0 / (sign + n.z);
    float b = n.x * n.y * a;

    tangent   = float3(1.0 + sign * n.x * n.x * a, sign * b, -sign * n.x);
    bitangent = float3(b, sign + n.y * n.y * a, -n.y);
}

float3 ApplySaturation(float3 color, float saturation)
{
    // Rec. 709 luma weights
    float luma = dot(color, float3(0.2126, 0.7152, 0.0722));
    return lerp(float3(luma, luma, luma), color, saturation);
}

float2 ProjectToPixel(float4x4 worldToClip, float3 p)
{
    float4 clip = mul(float4(p, 1.0), worldToClip);
    float2 ndc = clip.xy / clip.w;
    return (ndc * 0.5 + 0.5) * float2(DispatchRaysDimensions().xy);
}

float3 GetMotion(float3 x, float3 preX, float4x4 worldToView, float4x4 preWorldToView, float4x4 worldToClip, float4x4 preWorldToClip)
{
    float2 rect = float2(DispatchRaysDimensions().xy);

    float viewZ     = mul(float4(x,     1.0), worldToView).z;
    float viewZPrev = mul(float4(preX, 1.0), preWorldToView).z;

    float2 uv     = ProjectToPixel(worldToClip,    x)     / rect;
    float2 uvPrev = ProjectToPixel(preWorldToClip, preX) / rect;

    float3 motion;
    motion.xy = (uvPrev - uv) * rect;
    motion.z  = viewZPrev - viewZ;
    return motion;
}
